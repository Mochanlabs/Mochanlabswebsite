# Database Configuration
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/mochanlabs?retryWrites=true&w=majority

# Server Configuration
PORT=3000
NODE_ENV=development

# Email Configuration (Gmail SMTP)
GMAIL_USER=mochanlabs@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password_here

# Security Configuration
ADMIN_EMAIL=mochanlabs@gmail.com
OTP_EXPIRY=600

# Instructions for Gmail App Password:
# 1. Go to myaccount.google.com and enable 2FA
# 2. Visit myaccount.google.com/apppasswords
# 3. Select "Mail" and "Windows Computer"
# 4. Copy the 16-character password and paste above
